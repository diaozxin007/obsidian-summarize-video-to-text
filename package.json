{
  "name": "obsidian-summarize-video-to-text",
  "version": "0.2.2",
  "description": "Turn a YouTube / TikTok / Instagram video into a structured Obsidian note with summarizevideototext.com",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:debug": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs debug",
    "test": "vitest run",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "youtube",
    "summary",
    "transcript"
  ],
  "author": "diaozxin007",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.11",
    "@types/node": "^24.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
